osv_control_version = "v1.2.11"

# VEX: every advisory whose range holds a pin, with why it does not reach the profile. An advisory that holds
# a pin and has no line here is one this file has not yet answered. `status` and `justification` use the
# OpenVEX vocabulary. A line here is a claim about THIS profile's build (its CMakeLists.txt: curl with HTTP/1.1
# only, Mbed TLS as curl's TLS, zlib only for curl's content decoding); a profile change re-reads every line.

[[vex]]
pin = "zlib"
id = "CVE-2026-85091"
status = "not_affected"
justification = "vulnerable_code_not_present"
reason = """gz_vacate() is reached only through gzwrite()/gzprintf(); curl's lib/ calls only inflateInit2 and \
inflate. The profile's ld -r is seeded by the bridge object and pulls only the zlib members curl's decoding path \
references, so gzwrite.c's member is never in the archive (RayClay's identity test checks that the merged object \
defines no gz_vacate and no gzwrite). OSV range: introduced 570720b0c24f, last_affected da607da739fa."""

[[vex]]
pin = "zlib"
id = "CVE-2026-76844"
status = "not_affected"
justification = "vulnerable_code_not_present"
reason = """The stale next_in pointer is left by gz_write() after a failed write(); it is reached only through \
the gzwrite family, which the profile never links (the same seed-form ld -r as CVE-2026-85091). Found by the \
advisory watch's first query, on 2026-10-27. OSV range: introduced \
cacf7f1d4e3d, fixed df84af25dc19 (unreleased at import)."""

[[vex]]
pin = "mbedtls"
id = "CVE-2026-25832"
status = "not_affected"
justification = "vulnerable_code_cannot_be_controlled_by_adversary"
reason = """Advisory mbedtls-security-advisory-2026-07-tls13-hrr-unadvertised-group (LOW): a TLS 1.3 client \
accepts a HelloRetryRequest naming a group it did not advertise, which bypasses a group policy the APPLICATION \
configured with mbedtls_ssl_conf_groups(). The advisory names that configuration as a precondition. curl \
8.23.0's Mbed TLS backend (lib/vtls/mbedtls.c) never calls mbedtls_ssl_conf_groups() or _conf_curves(); RayClay's \
rc_net_curl.c sets no CURLOPT_SSL_EC_CURVES, and the bridge's CURLOPT_SSL_CTX_FUNCTION callback sets only the CA \
chain, so the profile has no group policy to bypass. That holds for this profile's TLS configuration only: a \
change to it re-reads this line. \
Upstream disagrees with itself: the advisory lists 4.1.1 as affected and 4.1.2 as fixed, while the 4.1.1 \
release notes list this fix and an upgrade to TF-PSA-Crypto 1.2.0. The pinned tarball's bytes: \
library/ssl_tls13_client.c:406-418 already carries the advisory's basic fix (the HelloRetryRequest's group must \
be one the ClientHello offered and supports), :436-441 rejects any other, and tf-psa-crypto/ is 1.1.1, not \
1.2.0. Neither the notes nor that source reading is a whole-advisory fix; see the pin's `maintenance`."""

[[vex]]
pin = "mbedtls"
id = "CVE-2025-66442"
status = "not_affected"
justification = "inline_mitigations_already_exist"
reason = """Advisory mbedtls-security-advisory-2026-03-compiler-induced-constant-time-violations (LOW, every \
version, no fixed release): a compiler can turn constant-time C into branches; the advisory's known case is \
Clang 18's select-optimize compiling for 64-bit RISC-V. Its mitigation is TF-PSA-Crypto's assembly constant-time \
primitives: per the advisory, 32- and 64-bit Arm and x86 are not affected where MBEDTLS_HAVE_ASM is enabled and \
a GCC-like compiler builds them. tf-psa-crypto/utilities/constant_time_impl.h:35-48 picks the assembly from \
those compiler, configuration and architecture macros, and each primitive's branch also depends on the \
condition width. The profile keeps the default MBEDTLS_HAVE_ASM (tf-psa-crypto/include/psa/crypto_config.h:1728; \
rc_net_profile_psa.h does not undefine it). RayClay's own coverage is NARROWER than that scope, a qualification \
boundary and not a statement of where the advisory applies: built and tested for x86-64 Linux with gcc 12 to \
15 and clang 18 to 21, and built for arm64-v8a Android with the NDK r28c's clang 19. It admits a gcc or clang \
of any version on x86-64 Linux, and the NDK's clang 19 or later on arm64-v8a Android, by the two checks \
below. So the profile's CMakeLists.txt \
builds the archive only where a probe, configured with the upstreams' own arguments and compiled under the C \
flags their translation units get, shows MBEDTLS_HAVE_ASM and the assembly branch on an admitted compiler and \
target, and refuses at configure anywhere else; its build then stops when the merged object defines \
mbedtls_ct_zero (compiled only without the assembly) or is for another machine. This line holds for the archives \
those two checks pass. They read the preprocessor's branch and the objects made, not the code a compiler \
generates or its timing."""
