# PINS - the three upstream tarballs of RayClay's Linux network profile (TOML).
#
# The pristine release tarballs, their licence texts (LICENSES/) and this file are DATA ONLY. RayClay's own
# profile code (rc_net_profile.c, rc_net_profile.h, rc_net_profile_psa.h and the profile's CMakeLists.txt) is
# first-party; RayClay ships it beside this file, in the same netprofile/ directory.
#
# Read by:
#   - a checksum check: each [[pin]]'s `file` must hash to its `sha256`;
#   - an advisory check: each feed, against `version` and the [[vex]] lines;
#   - the profile's identity TAG, a hash of its pins and its sources taken whenever they change:
#     the anchor lines in rc_net_profile.h and rayclay.h name it, so a profile change renames the
#     anchor, and every program that calls rcFetch, rcWebSocket or rcUpdateCheck is rebuilt against
#     the new archive. A build recomputes nothing: the TAG is the string the profile shipped with.
#
# Imported 2026-10-27. Each sha256 was checked on import against three independent sources:
#   - the value recorded when the three releases were chosen;
#   - the GitHub release API's asset digest for the same file (curl/curl, Mbed-TLS/mbedtls, madler/zlib);
#   - curl and zlib: the upstream OpenPGP signature (`.asc`) verified with gpg against the fingerprint below;
#     Mbed TLS publishes no signature: its release notes' checksum block and its `-sha256sum.txt` asset.

[[pin]]
name = "curl"
version = "8.23.0"
file = "curl-8.23.0.tar.xz"
released = "2026-10-14"
spdx = "curl"
url = "https://curl.se/download/curl-8.23.0.tar.xz"
size = 2990916
sha256 = "8dadd7d2536a314f982ad05a651b713f426bf7d02cc2c76cffb9796f2218e6c5"
signature = "gpg GOODSIG/VALIDSIG on curl-8.23.0.tar.xz.asc, key 27EDEAF22F3ABCEB50DB9A125CC908FDB71E12C2"
feed = "curl-vuln-json"
feed_url = "https://curl.se/docs/vuln.json"

[[pin]]
name = "mbedtls"
version = "4.1.1"
file = "mbedtls-4.1.1.tar.bz2"
released = "2026-07-07"
spdx = "Apache-2.0 OR GPL-2.0-or-later"
url = "https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-4.1.1/mbedtls-4.1.1.tar.bz2"
size = 7099934
sha256 = "3359a349e23db3d5536fcee032ae7b2ecbfc08972fab643089b5cbf2a375c98c"
signature = "no signature published; sha256 matched in 3 upstream places (release notes, sha256sum asset, asset digest)"
includes = "TF-PSA-Crypto 1.1.1 (the tarball's tf-psa-crypto/, same dual licence; it counts as one upstream with Mbed TLS)"
feed = "mbedtls-advisories-index"
feed_url = "https://mbed-tls.readthedocs.io/en/latest/security-advisories/"
# OSV coverage, measured on import: OSV's GIT queries for https://github.com/Mbed-TLS/mbedtls return 0
# vulnerabilities for mbedtls-4.1.1 AND for mbedtls-2.28.0, 3.6.0 and 4.0.0, which have advisories. So OSV does not
# cover Mbed TLS; the advisories index is the feed. On import every index entry from 2025-10 (the 4.x line's
# first release) to 2026-07 was read; earlier entries predate the 4.x line. Two hold 4.1.1: both have [[vex]] lines.
advisories_reviewed_through = "2026-07"
# A standing duty, not a schedule: the next Mbed TLS 4.1.x patch release replaces this pin once it is published
# and verified. Among the steps: authenticate the complete asset as on import (a checksum the release shows twice
# is not two authorities); read its nested sources, versions and notices; update every CMake file name, hash and
# versioned prefix and this file's lines; re-tag; rebuild clean and incremental, and check that an archive of the
# old profile no longer links; rebuild and ship again every program that links the profile; reconcile upstream's
# advisories with the source before naming what the update fixes. None was found at 2026-10-28T00:12Z (the GitHub
# release list's newest: 4.2.0 and 4.1.1; releases/tag/mbedtls-4.1.2 answered 404); no substitute is fetched before.
maintenance = "take the next verified 4.1.x patch release (CVE-2026-25832's listed fix release is 4.1.2)"
# Upstream's notice "Future Maintenance of Mbed TLS" (mbed-tls-announce, 2026-10-08): the present maintainers
# keep TF-PSA-Crypto but stop maintaining the TLS and X.509 libraries from April 2027, and unless new
# maintainers have joined by then, their security fixes and releases cease. Re-read the list before 2027-04:
# if no one maintains them then, this profile's TLS gets no security releases, and keeping it is a decision to
# make before that date.

